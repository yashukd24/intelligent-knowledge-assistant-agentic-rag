# ============================================================
# Intelligent Knowledge Assistant - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider Selection ---
# Options: ollama (local, default, no API key required), anthropic (cloud)
LLM_PROVIDER=ollama

# --- Local Ollama Settings (Active when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_NUM_CTX=2048
OLLAMA_MAX_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1

# --- Anthropic Claude API (Active when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=30

# --- Claude Model Selection (Alternative configuration names) ---
# Active standard model: claude-sonnet-5
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.1

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true

# --- Frontend ---
FRONTEND_PORT=8501

# --- SQLite Database ---
DATABASE_URL=sqlite:///./data/knowledge_assistant.db

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=knowledge_base

# --- Embedding Model ---
# Downloaded on first use in Phase 5 — do NOT pre-download in Phase 1-4
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Document Processing ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_EXTENSIONS=.pdf,.docx,.txt

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3

# --- Agent ---
AGENT_MAX_ITERATIONS=5
AGENT_REFINEMENT_ROUNDS=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Evaluation ---
EVAL_QUESTIONS_PATH=./data/eval_questions/questions.json
